---
import { site } from '../data/content';
---

<footer class="relative overflow-hidden border-t border-line">
  <div class="mx-auto max-w-6xl px-5 pt-14 sm:px-8">
    <div class="mono flex flex-col gap-6 text-[0.72rem] tracking-[0.08em] text-muted uppercase sm:flex-row sm:items-center sm:justify-between">
      <p>{site.tagline}</p>
      <div class="flex gap-6">
        <a href={site.repoUrl} target="_blank" rel="noopener" class="transition-colors hover:text-accent">
          Source ↗
        </a>
        <a href={site.downloadUrl} class="transition-colors hover:text-accent">Download ↓</a>
      </div>
    </div>

    <p class="mono mt-8 max-w-2xl text-[0.68rem] leading-relaxed text-faint">
      Exercise demonstrations from{' '}
      <a
        href={site.datasetUrl}
        target="_blank"
        rel="noopener"
        class="underline underline-offset-2 hover:text-fg"
      >
        ExerciseGymGifsDB</a
      >, pinned to <span class="tnum">v1.1.0</span>. GIFs © their respective authors.
      Released under the MIT licence. Made by {site.author}.
    </p>
  </div>

  <!-- Wordmark, cropped by the page edge on purpose. -->
  <p
    aria-hidden="true"
    class="poster outline-type pointer-events-none mt-6 translate-y-[18%] text-center text-[clamp(4rem,18vw,15rem)] leading-[0.8] select-none"
  >
    Log Lift
  </p>
</footer>
