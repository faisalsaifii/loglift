---
/**
 * The primary download call to action: a big violet pill with a neutral download
 * arrow. (Not a Play badge — the app ships as a GitHub release APK, and the Play
 * triangle is Google's trademark.)
 */
import { site } from '../data/content';

interface Props {
  href?: string;
  /** `accent` on dark surfaces, `ink` on the violet closing panel. */
  tone?: 'accent' | 'ink';
  class?: string;
}

const { href = site.downloadUrl, tone = 'accent', class: className = '' } = Astro.props;
---

<a
  href={href}
  class:list={[
    'sheen group inline-flex items-center gap-4 rounded-full py-3 pr-3 pl-7 transition-transform duration-300 hover:scale-[1.03] active:scale-[0.98]',
    tone === 'accent' ? 'bg-accent text-on-accent' : 'bg-bg text-fg',
    className,
  ]}
>
  <span class="relative z-10 flex flex-col leading-none">
    <span class="mono text-[0.6rem] font-medium tracking-[0.18em] uppercase opacity-70">Download for</span>
    <span class="poster mt-1.5 text-[1.6rem]">Android</span>
  </span>
  <span
    class:list={[
      'relative z-10 flex h-12 w-12 items-center justify-center rounded-full transition-transform duration-300 group-hover:translate-y-0.5',
      tone === 'accent' ? 'bg-bg text-accent' : 'bg-accent text-on-accent',
    ]}
  >
    <svg
      viewBox="0 0 24 24"
      aria-hidden="true"
      class="h-6 w-6"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M12 4v11"></path>
      <path d="m7 11 5 5 5-5"></path>
      <path d="M5 20h14"></path>
    </svg>
  </span>
</a>
