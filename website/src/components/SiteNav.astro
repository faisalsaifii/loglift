---
import { site } from '../data/content';

const links = [
  { href: '#how', label: 'How it works' },
  { href: '#features', label: 'Features' },
] as const;
---

<header data-header class="fixed inset-x-0 top-0 z-50 px-3 pt-3 sm:px-6 sm:pt-5">
  <div
    class="mx-auto flex h-14 max-w-5xl items-center gap-4 rounded-full border border-line-strong bg-bg/70 pr-2 pl-5 backdrop-blur-xl"
  >
    <a href="#top" class="flex items-center gap-2.5">
      <img src="/favicon.png" alt="" class="h-6 w-6 rounded-md" width="24" height="24" />
      <span class="poster text-[1.15rem] leading-none">{site.name}</span>
    </a>

    <nav class="mono ml-auto hidden items-center gap-6 text-[0.72rem] tracking-[0.08em] uppercase md:flex">
      {
        links.map((link) => (
          <a href={link.href} class="text-muted transition-colors hover:text-accent">
            {link.label}
          </a>
        ))
      }
      <a
        href={site.repoUrl}
        target="_blank"
        rel="noopener"
        class="text-muted transition-colors hover:text-accent"
      >
        GitHub ↗
      </a>
    </nav>

    <a
      href={site.downloadUrl}
      class="mono ml-auto rounded-full bg-accent px-4 py-2.5 text-[0.72rem] font-semibold tracking-[0.08em] text-on-accent uppercase transition-transform hover:scale-[1.04] md:ml-0"
    >
      Get the APK
    </a>
  </div>

  <!-- Reading progress hairline, tucked under the pill. -->
  <div
    data-progress
    aria-hidden="true"
    class="mx-auto mt-2 h-px max-w-5xl origin-left scale-x-0 bg-accent transition-transform duration-150 ease-out"
  >
  </div>
</header>
