---
import DownloadBadge from '../components/DownloadBadge.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteNav from '../components/SiteNav.astro';
import {
  bodyParts,
  closing,
  features,
  featuresIntro,
  hero,
  loop,
  site,
  stats,
  structuredData,
} from '../data/content';
import Base from '../layouts/Base.astro';

/**
 * Describes the page to search engines: the site, the app and its author, in one
 * `@graph`. Built against the configured origin for the same reason the canonical
 * is — so the absolute URLs inside it are never the dev server's.
 */
const jsonLd = structuredData(Astro.site ?? Astro.url);

/**
 * The headline is three lines, each with its own voice: plain poster type, then
 * violet italic serif, then hollow outline. Words are flattened so each can animate
 * on its own delay, but the line they belong to is kept.
 */
const lineStyles = [
  '',
  'aside text-accent text-[1.14em] normal-case',
  'outline-type',
] as const;

let wordIndex = 0;
const headline = hero.title.map((sentence, line) => ({
  style: lineStyles[line] ?? '',
  words: sentence.split(' ').map((word) => ({ word, index: wordIndex++ })),
}));

/** Longest bar = 100%, so the chart reads as proportions rather than raw counts. */
const maxCount = Math.max(...bodyParts.map((part) => part.count));

/** The ticker is rendered twice back to back so a -50% translate loops seamlessly. */
const ticker = [...bodyParts, ...bodyParts];

const [catalogue, demo, log, record] = features;
---

<Base jsonLd={jsonLd}>
  <div id="top"></div>
  <SiteNav />

  <main>
    <!-- ── Hero ─────────────────────────────────────────────────────────── -->
    <section class="relative overflow-hidden">
      <div class="grid-tex pointer-events-none absolute inset-0" aria-hidden="true"></div>

      <div class="relative z-10 mx-auto max-w-7xl px-5 pt-24 pb-10 sm:px-8 sm:pt-28">
        <a
          href={site.downloadUrl}
          class="mono animate-rise inline-flex items-center gap-2.5 rounded-full border border-line-strong py-1.5 pr-4 pl-1.5 text-[0.7rem] tracking-[0.08em] uppercase"
        >
          <span class="rounded-full bg-accent px-2.5 py-1 font-semibold text-on-accent">New</span>
          v{site.version} · direct APK · no store
        </a>

        <!--
          One animation per word. The spaces are real text nodes between the
          spans (not inside them): `.word` is an inline-block, and a trailing space
          inside one is trimmed, which would set the words solid.
        -->
        <h1 class="poster hero-type mt-6">
          {
            headline.map((line) => (
              <span class:list={['block', line.style]}>
                {line.words.map(({ word, index }) => (
                  <>
                    <span class="word" style={`--word-delay:${120 + index * 70}ms`}>
                      {word}
                    </span>{' '}
                  </>
                ))}
              </span>
            ))
          }
        </h1>

        <div class="mt-8 grid items-end gap-10 lg:block">
          <div class="max-w-xl animate-rise [animation-delay:700ms]">
            <p class="lede max-w-lg !text-[1.02rem]">{hero.lede}</p>

            <div class="mt-6 flex flex-wrap items-center gap-x-8 gap-y-5">
              <DownloadBadge />
              <a
                href="#how"
                class="mono group inline-flex items-center gap-2 text-[0.75rem] tracking-[0.08em] text-muted uppercase transition-colors hover:text-accent"
              >
                {hero.secondary}
                <span class="transition-transform group-hover:translate-y-1">↓</span>
              </a>
            </div>

            <p class="mono mt-5 text-[0.68rem] tracking-[0.08em] text-faint uppercase">
              {hero.note}
            </p>
          </div>

          <!-- A sample set, drawn as a receipt: the product's one idea in a card. -->
          <div class="float relative mx-auto w-full max-w-[16rem] animate-rise [animation-delay:900ms] lg:absolute lg:top-32 lg:right-8 lg:mx-0 lg:max-w-[15rem] xl:right-12">
            <div
              class="mono relative rounded-2xl bg-fg p-5 pb-6 text-on-accent shadow-[0_40px_90px_-30px_rgba(176,92,255,0.35)]"
            >
              <div class="flex items-center justify-between text-[0.62rem] tracking-[0.16em] uppercase">
                <span class="font-semibold">Set log</span>
                <span class="opacity-50">Sample</span>
              </div>

              <p class="poster mt-4 text-[1.4rem] leading-none">Bench press</p>
              <p class="poster mt-2 text-[3.4rem] leading-[0.82]">
                100<span class="text-[0.4em] opacity-60"> kg</span> ×5
              </p>

              <div class="mt-4 flex gap-1.5" aria-hidden="true">
                <span class="h-2.5 flex-1 rounded-full bg-on-accent"></span>
                <span class="h-2.5 flex-1 rounded-full bg-on-accent"></span>
                <span class="h-2.5 flex-1 rounded-full bg-on-accent"></span>
                <span class="h-2.5 flex-1 rounded-full bg-on-accent"></span>
                <span class="h-2.5 flex-1 rounded-full bg-on-accent"></span>
              </div>

              <div class="mt-4 border-t border-dashed border-on-accent/40 pt-3 text-[0.7rem] leading-6">
                <p class="flex justify-between"><span class="opacity-60">Est. 1RM</span><span class="tnum font-semibold">116.7 kg</span></p>
                <p class="flex justify-between"><span class="opacity-60">Volume</span><span class="tnum font-semibold">500 kg</span></p>
                <p class="flex justify-between"><span class="opacity-60">Beats best by</span><span class="tnum font-semibold">+2.5 kg</span></p>
              </div>

              <div
                class="stamp poster absolute -top-5 -right-5 rounded-lg border-[3px] border-on-accent bg-accent px-3.5 py-2 text-[1.55rem] leading-none text-on-accent"
              >
                New PR
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Ticker ───────────────────────────────────────────────────────────
         Two crossing strips. The violet one carries the catalogue; the dark one
         underneath runs the other way and says the quiet part. -->
    <div class="relative overflow-hidden py-10" aria-hidden="true">
      <div class="-rotate-[1.6deg] bg-accent py-4 text-on-accent">
        <div class="marquee animate-marquee">
          {
            ticker.map((part) => (
              <span class="poster flex shrink-0 items-center gap-6 pr-6 text-[1.7rem] sm:text-[2.4rem]">
                {part.name}
                <span class="mono text-[0.9rem] font-medium tracking-normal opacity-60">{part.count}</span>
                <span class="text-[1.4rem]">✦</span>
              </span>
            ))
          }
        </div>
      </div>
      <div class="-mt-3 rotate-[1.2deg] border-y border-line-strong bg-bg py-3">
        <div class="marquee animate-marquee-rev">
          {
            [...Array(8)].map(() => (
              <span class="mono shrink-0 pr-10 text-[0.78rem] tracking-[0.2em] text-muted uppercase">
                No account · No tracking · Works offline · Free · Open source ·
              </span>
            ))
          }
        </div>
      </div>
    </div>

    <!-- ── Stats ────────────────────────────────────────────────────────── -->
    <section class="border-b border-line">
      <div class="mx-auto grid max-w-7xl grid-cols-2 lg:grid-cols-4">
        {
          stats.map((stat, i) => (
            <div
              data-reveal
              data-reveal-delay={i * 90}
              class="border-line px-5 py-8 sm:px-8 sm:py-10 [&:nth-child(odd)]:border-r [&:nth-child(-n+2)]:border-b lg:border-r lg:border-b-0 lg:last:border-r-0"
            >
              <p class="poster text-[clamp(2.8rem,6vw,5.2rem)] text-accent tnum">
                <span data-count={stat.value}>{stat.value.toLocaleString('en-US')}</span>
              </p>
              <p class="mono mt-3 text-[0.72rem] tracking-[0.1em] text-muted uppercase">
                {stat.label}
              </p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- ── Features: bento ──────────────────────────────────────────────── -->
    <section id="features" class="scroll-mt-20">
      <div class="mx-auto max-w-7xl px-5 py-16 sm:px-8 sm:py-20">
        <div data-reveal class="max-w-4xl">
          <p class="eyebrow">{featuresIntro.eyebrow}</p>
          <h2 class="poster section-type mt-5">
            The parts other apps <span class="aside text-accent normal-case">charge</span> for
          </h2>
          <p class="lede mt-6 max-w-xl">{featuresIntro.lede}</p>
        </div>

        <div class="mt-10 grid gap-4 lg:grid-cols-6">
          <!-- Catalogue + proportional bars, straight from `bodyParts`. -->
          <article data-reveal class="tile flex flex-col p-7 sm:p-9 lg:col-span-4 lg:row-span-2">
            <p class="mono text-[0.7rem] tracking-[0.14em] text-accent uppercase">01 / Catalogue</p>
            <h3 class="poster mt-4 text-[clamp(1.8rem,3vw,2.6rem)]">{catalogue.title}</h3>
            <p class="mt-4 max-w-md text-[0.95rem] leading-relaxed text-muted">{catalogue.body}</p>

            <ul class="mono mt-10 flex flex-1 flex-col justify-between gap-3.5">
              {
                bodyParts.map((part, i) => (
                  <li class="flex items-center gap-4 text-[0.72rem] tracking-[0.08em] uppercase">
                    <span class="w-20 shrink-0 text-muted">{part.name}</span>
                    <span class="h-4 flex-1 overflow-hidden rounded-full bg-line">
                      <span
                        class="bar block h-full rounded-full bg-accent"
                        style={`--w:${((part.count / maxCount) * 100).toFixed(1)}%;--bar-delay:${i * 90}ms`}
                      />
                    </span>
                    <span class="tnum w-9 text-right text-fg">{part.count}</span>
                  </li>
                ))
              }
            </ul>
          </article>

          <!-- Form demo: a looping scrubber. -->
          <article data-reveal data-reveal-delay="90" class="tile flex flex-col p-7 sm:p-8 lg:col-span-2">
            <p class="mono text-[0.7rem] tracking-[0.14em] text-accent uppercase">02 / Form</p>
            <div class="relative mt-5 grid aspect-[16/10] place-items-center overflow-hidden rounded-2xl border border-line-strong bg-bg" aria-hidden="true">
              <span class="grid h-14 w-14 place-items-center rounded-full bg-accent text-on-accent">
                <svg viewBox="0 0 24 24" class="ml-0.5 h-6 w-6" fill="currentColor"><path d="M8 5.5v13l11-6.5z"></path></svg>
              </span>
              <span class="absolute inset-x-4 bottom-4 h-1 overflow-hidden rounded-full bg-line-strong">
                <span class="scrub block h-full bg-accent"></span>
              </span>
            </div>
            <h3 class="poster mt-6 text-[1.9rem]">{demo.title}</h3>
            <p class="mt-3 text-[0.9rem] leading-relaxed text-muted">{demo.body}</p>
          </article>

          <!-- Four seconds: a ring that fills on a loop. -->
          <article data-reveal data-reveal-delay="180" class="tile flex flex-col p-7 sm:p-8 lg:col-span-2">
            <p class="mono text-[0.7rem] tracking-[0.14em] text-accent uppercase">03 / Speed</p>
            <div class="relative mx-auto mt-5 grid h-36 w-36 place-items-center" aria-hidden="true">
              <svg viewBox="0 0 100 100" class="absolute inset-0 -rotate-90">
                <circle cx="50" cy="50" r="44" fill="none" stroke="var(--line-strong)" stroke-width="5"></circle>
                <circle
                  cx="50"
                  cy="50"
                  r="44"
                  fill="none"
                  stroke="var(--accent)"
                  stroke-width="5"
                  stroke-linecap="round"
                  pathLength="1"
                  class="ring"
                ></circle>
              </svg>
              <span class="poster text-[3.6rem] leading-none">4<span class="aside text-accent text-[0.7em] normal-case">s</span></span>
            </div>
            <h3 class="poster mt-6 text-[1.9rem]">{log.title}</h3>
            <p class="mt-3 text-[0.9rem] leading-relaxed text-muted">{log.body}</p>
          </article>

          <!-- Records: the one loud tile. -->
          <article data-reveal class="tile tile-accent grid gap-8 p-7 sm:p-10 lg:col-span-6 lg:grid-cols-[1fr_1.1fr] lg:items-center">
            <div>
              <p class="mono text-[0.7rem] tracking-[0.14em] uppercase opacity-70">04 / Records</p>
              <h3 class="poster mt-4 text-[clamp(2.2rem,4vw,3.4rem)]">{record.title}</h3>
              <p class="mt-5 max-w-md text-[1rem] leading-relaxed opacity-80">{record.body}</p>
            </div>

            <div class="relative" aria-hidden="true">
              <svg viewBox="0 0 400 160" class="w-full overflow-visible" fill="none">
                <path d="M0 150 H400" stroke="currentColor" stroke-opacity="0.18"></path>
                <path d="M0 105 H400" stroke="currentColor" stroke-opacity="0.12" stroke-dasharray="3 6"></path>
                <path d="M0 60 H400" stroke="currentColor" stroke-opacity="0.12" stroke-dasharray="3 6"></path>
                <path
                  pathLength="1"
                  class="draw"
                  d="M4 138 L52 126 L100 131 L148 108 L196 114 L244 86 L292 92 L340 52 L388 22"
                  stroke="currentColor"
                  stroke-width="4"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
                <circle cx="388" cy="22" r="8" fill="currentColor"></circle>
                <circle cx="388" cy="22" r="18" stroke="currentColor" stroke-opacity="0.35" stroke-width="2"></circle>
              </svg>
              <span class="poster absolute top-0 left-0 rounded-md bg-on-accent px-2.5 py-1.5 text-[1.1rem] leading-none text-accent">
                New PR
              </span>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- ── How it works: an oversized ledger ────────────────────────────── -->
    <section id="how" class="band-sunken scroll-mt-20 border-y border-line">
      <div class="mx-auto max-w-7xl px-5 py-16 sm:px-8 sm:py-20">
        <div data-reveal class="max-w-4xl">
          <p class="eyebrow">{loop.eyebrow}</p>
          <h2 class="poster section-type mt-5">
            The loop, <span class="aside text-accent normal-case">start to finish</span>
          </h2>
          <p class="lede mt-6 max-w-xl">{loop.lede}</p>
        </div>

        <ol class="mt-10 border-b border-line">
          {
            loop.items.map((item, i) => (
              <li data-reveal data-reveal-delay={i * 60}>
                <div class="group grid items-baseline gap-x-10 gap-y-3 border-t border-line px-2 py-6 transition-colors duration-500 hover:bg-accent hover:text-on-accent sm:px-6 md:grid-cols-[minmax(6rem,8rem)_1fr_1fr] md:py-7">
                  <span class="poster outline-type tnum text-[clamp(3rem,6vw,5rem)] transition-colors duration-500 group-hover:[-webkit-text-stroke-color:var(--on-accent)]">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <h3 class="poster text-[clamp(1.8rem,3.4vw,3rem)] leading-[0.9]">{item.title}</h3>
                  <p class="max-w-md text-[0.98rem] leading-relaxed text-muted transition-colors duration-500 group-hover:text-on-accent/75">
                    {item.body}
                  </p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- ── Closing CTA ──────────────────────────────────────────────────── -->
    <section id="get" class="scroll-mt-20">
      <div class="mx-auto max-w-7xl px-5 py-16 sm:px-8 sm:py-20">
        <div data-reveal class="tile tile-accent p-8 sm:p-12 lg:p-14">
          <h2 class="poster text-[clamp(2.8rem,7vw,6.5rem)]">
            Start logging <span class="aside normal-case">in the next rep</span>
          </h2>

          <div class="mt-8 flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
            <p class="max-w-md text-[1.05rem] leading-relaxed opacity-80">{closing.lede}</p>
            <div class="flex flex-col items-start gap-4">
              <DownloadBadge tone="ink" />
              <p class="mono max-w-64 text-[0.66rem] leading-relaxed tracking-[0.06em] uppercase opacity-65">
                {closing.install}
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</Base>
