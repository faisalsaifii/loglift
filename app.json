{
  "expo": {
    "name": "Log Lift",
    "slug": "loglift",
    "description": "Strength-training exercise reference and personal-record logger. Browse exercises, track your library, and log sets with PR detection.",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "loglift",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.loglift.app",
      "icon": "./assets/expo.icon",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.loglift.app",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "resizeMode": "contain"
        }
      ],
      "@react-native-vector-icons/material-design-icons"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "assetBundlePatterns": ["**/*"],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f3e3d88e-5ba4-4099-a60a-7db78aa0b5cc"
      }
    }
  }
}
